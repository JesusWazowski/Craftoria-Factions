# Protection policy for new worlds; merge these keys into existing world overrides.
{
	disable_protection: true
	fire_spread_protection: false
	flowing_fluid_protection: false
	piston_protection: false
	protect_unknown_explosions: false
	pvp_mode: "always"
	no_wilderness: false
	no_wilderness_dimensions: [ ]
	fake_players: { fake_players: "allow" }
	team_prop_defaults: {
		def_allow_explosions: true
		def_block_edit: "public"
		def_block_edit_interact: "public"
		def_block_interact: "public"
		def_entity_attack: "public"
		def_entity_interact: "public"
		def_fake_player_ids: true
		def_fake_players: true
		def_mob_griefing: true
		def_named_fake_players: [ ]
		def_pvp: true
	}
}
